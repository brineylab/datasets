#!/usr/bin/env bash
# scripts/build <name> <outroot> [podman]: run datasets/<name>'s recipe into <outroot>/<name>/<tree>/, <tree>
# being git's hash of its committed recipe/, from committed inputs only, once the directory passes check.py's
# rules; or skip, when that directory is already built. With podman, the recipe runs in its tool's image;
# without, it runs here, which is how it runs inside the image under srun.
set -euo pipefail
usage() { echo "usage: scripts/build <name> <outroot> [podman]" >&2; exit 2; }
[[ $# -eq 2 || ( $# -eq 3 && $3 == podman ) ]] || usage
name=$1 runner=${3:-}
mkdir -p "$2"; outroot=$(cd "$2" && pwd)  # podman mounts it, so it is absolute
cd "$(dirname "$0")/.."
if [[ -n "$(git status --porcelain --ignored -- "datasets/$name")" ]]; then
  echo "datasets/$name has uncommitted changes; commit them first" >&2; exit 1
fi
python3 -I scripts/check.py "datasets/$name" || exit 1  # its rules, a credential among them, before anything runs
out=$outroot/$name/$(python3 -I scripts/check.py --tree "datasets/$name")
if [[ -e "$out/.built" ]]; then echo "built: $out (skipped)"; exit 0; fi
mkdir -p "$out"
cmd=("datasets/$name/recipe/build" "$out")
if [[ $runner == podman ]]; then
  image=$(python3 -I -c "import sys; sys.path.insert(0, 'scripts'); import check, pathlib; t = check.frontmatter(pathlib.Path('datasets/$name/SKILL.md'))['metadata']['tool']; print(check.toolshed_registry() + '/' + t.replace('@', ':'))")
  cmd=(podman run --rm --userns=keep-id -v "$PWD":/work -v "$outroot":"$outroot" -w /work "$image" "${cmd[@]}")
fi
"${cmd[@]}"
touch "$out/.built"
echo "built: $out"
