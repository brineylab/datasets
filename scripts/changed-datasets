#!/usr/bin/env bash
# scripts/changed-datasets <git diff range>: the datasets whose directories changed and still exist, one per line.
set -euo pipefail
cd "$(dirname "$0")/.."
git diff --name-only "$@" -- datasets/ | cut -d/ -f2 | sort -u | while read -r d; do
  if [[ -d "datasets/$d" ]]; then echo "$d"; fi
done
