#!/usr/bin/env -S python3 -I
"""scripts/push <name> <output dir>: upload the directory the cook ran the recipe into to the Hub as the
candidate, the branch candidate-<tree> on <org>/<name>, <tree> the committed recipe's, replacing any earlier
one; then the card, README.md, from the skill. Refuses, before anything reaches the Hub, a dataset directory
that breaks check.py's rules (a credential among them: the card goes public here), one with uncommitted or
ignored changes, or one git cannot speak for, and an output holding no data files. Prints one
`file <path> <size> <sha256>` line per data file and last `commit: <sha>`, the branch's head, which
scripts/record reads. Paths under a name starting with `.` (a recipe's .work/) are neither uploaded nor
listed. The token is HF_TOKEN's and is never printed. Runs inside an image holding huggingface_hub and git.
"""
import hashlib
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import check  # noqa: E402
from huggingface_hub import HfApi  # noqa: E402

HIDDEN = [".*", "*/.*"]  # fnmatch's * crosses /, so these are every path with a part starting with "."


def sha256(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def card(skill: Path) -> str:
    """The Hub's README.md: a header with the license and the name, then the skill's body after its frontmatter."""
    meta = check.frontmatter(skill)
    body = skill.read_text(encoding="utf-8").split("\n---\n", 1)[1]
    return f"---\nlicense: {meta['metadata']['license']}\npretty_name: {meta['name']}\n---\n{body}"


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: scripts/push <name> <output dir>", file=sys.stderr)
        return 2
    name, out = sys.argv[1], Path(sys.argv[2]).resolve()
    dataset = check.ROOT / "datasets" / name
    reasons = check.rules(dataset)
    if reasons:
        print("\n".join(reasons), file=sys.stderr)
        return 1
    try:  # the candidate names the committed recipe, so what is pushed must be what is committed
        git = subprocess.run(["git", "status", "--porcelain", "--ignored", "--", f"datasets/{name}"],
                             cwd=check.ROOT, capture_output=True, text=True)
        why = git.stderr.strip() if git.returncode else None
    except OSError as e:
        why = str(e)
    if why is not None:
        print(f"cannot tell whether datasets/{name} is committed: {why}", file=sys.stderr)
        return 1
    if git.stdout.strip():
        print(f"datasets/{name} has uncommitted changes; commit them first", file=sys.stderr)
        return 1
    files = sorted(p for p in out.rglob("*") if p.is_file() and not any(part.startswith(".") for part in p.relative_to(out).parts)) if out.is_dir() else []
    if not files:
        print(f"{sys.argv[2]} holds no files to push", file=sys.stderr)
        return 1
    tree = check.tree_hash(dataset / "recipe")
    meta = check.frontmatter(dataset / "SKILL.md")["metadata"]
    if not os.environ.get("HF_TOKEN"):
        print("HF_TOKEN is not set: a Hub token with write access to the org's datasets", file=sys.stderr)
        return 1
    repo, branch = f"{check.hub_org()}/{name}", f"candidate-{tree}"
    api = HfApi(token=os.environ["HF_TOKEN"])
    api.create_repo(repo, repo_type="dataset", exist_ok=True)
    if branch in {b.name for b in api.list_repo_refs(repo, repo_type="dataset").branches}:
        # an earlier candidate of this tree: replaced, so the record's commit holds exactly this output
        api.delete_branch(repo, branch=branch, repo_type="dataset")
    api.create_branch(repo, branch=branch, revision="main", repo_type="dataset")
    api.upload_folder(folder_path=out, repo_id=repo, repo_type="dataset", revision=branch, ignore_patterns=HIDDEN,
                      commit_message=f"{name} {meta['version']}: the output of recipe tree {tree}")
    head = api.upload_file(path_or_fileobj=card(dataset / "SKILL.md").encode(), path_in_repo="README.md", repo_id=repo,
                           repo_type="dataset", revision=branch, commit_message=f"{name} {meta['version']}: the card")
    for p in files:
        print(f"file {p.relative_to(out).as_posix()} {p.stat().st_size} {sha256(p)}")
    print(f"commit: {head.oid}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
