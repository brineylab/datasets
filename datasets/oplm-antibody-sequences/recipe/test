#!/usr/bin/env -S python3 -I
"""recipe/test <out>: exit 0 iff <out> holds a version of oplm-antibody-sequences. Reads parquet footers, the four
held-out files, and the first and last shard of each train folder; one line per failure, naming the check and the
first offending sequence_id."""
import sys
import tomllib
from pathlib import Path

import polars as pl
import pyarrow.parquet as pq

params = tomllib.loads((Path(__file__).parent / "params.toml").read_text())
FLOOR = {"antiref96": 189_503_281, "antiref99": 284_384_885}  # rows: 90% of the first full build's
HELDOUT = ["eval_singletons", "eval_gte2", "test_singletons", "test_gte2"]
TRAIN_COLUMNS = {"antiref96": ["sequence_id", "sequence", "member_ids", "member_sequences"],
                 "antiref99": ["sequence_id", "sequence"]}
HELDOUT_COLUMNS = ["sequence_id", "sequence", "locus", "cdr_mask_aa"]

out, problems = Path(sys.argv[1]), []
held = {}
for name in HELDOUT:
    path = out / f"{name}.parquet"
    if not path.is_file():
        problems.append(f"files: {name}.parquet is missing")
        continue
    df = pl.read_parquet(path)
    if df.columns != HELDOUT_COLUMNS:
        problems.append(f"columns: {name}.parquet has {df.columns}, not {HELDOUT_COLUMNS}")
        continue
    if df.height != params["heldout"]:
        problems.append(f"rows: {name}.parquet has {df.height}, not {params['heldout']}")
    bad = {
        "locus": ~pl.col("locus").is_in(["IGH", "IGK", "IGL"]),
        "cdr_mask_aa length": pl.col("cdr_mask_aa").str.len_chars() != pl.col("sequence").str.len_chars(),
        "cdr_mask_aa digits": ~pl.col("cdr_mask_aa").str.contains(r"^[0-3]+$"),
        "cdr_mask_aa one CDR3": ~pl.col("cdr_mask_aa").str.contains(r"^[0-2]*3+[0-2]*$"),
    }
    for check, expr in bad.items():
        hit = df.filter(expr.fill_null(True))
        if hit.height:
            problems.append(f"{check}: {hit.height} rows in {name}.parquet, first {hit['sequence_id'][0]}")
    held[name] = set(df["sequence_id"])
    print(f"{name}.parquet {df.height} rows")

edges = {}
for folder, columns in TRAIN_COLUMNS.items():
    shards = sorted((out / folder / "train").glob("*.parquet"))
    if not shards:
        problems.append(f"files: {folder}/train has no shards")
        continue
    names = [p.name for p in shards]
    if names != [f"shard-{i:05d}.parquet" for i in range(len(shards))]:
        problems.append(f"files: {folder}/train's shards are not shard-00000.parquet onward without gaps")
    counts = [pq.ParquetFile(p).metadata.num_rows for p in shards]
    if any(n != params["shard_rows"] for n in counts[:-1]):
        problems.append(f"rows: a {folder}/train shard before the last is not {params['shard_rows']} rows")
    if sum(counts) < FLOOR[folder]:
        problems.append(f"rows: {folder}/train has {sum(counts)}, under its floor {FLOOR[folder]}")
    for p in {shards[0], shards[-1]}:
        df = pl.read_parquet(p)
        if df.columns != columns:
            problems.append(f"columns: {folder}/train/{p.name} has {df.columns}, not {columns}")
            continue
        edges[f"{folder}/train/{p.name}"] = set(df["sequence_id"])
        if folder == "antiref96":
            bad = df.filter(
                (pl.col("member_ids").list.first() != pl.col("sequence_id"))
                | (pl.col("member_sequences").list.first() != pl.col("sequence"))
                | (pl.col("member_ids").list.len() != pl.col("member_sequences").list.len())
            )
            if bad.height:
                problems.append(f"members: {bad.height} rows in {folder}/train/{p.name}, first {bad['sequence_id'][0]}")
    print(f"{folder}/train {len(shards)} shards {sum(counts)} rows")

seen = {}
for where, ids in [*held.items(), *edges.items()]:
    for name, other in seen.items():
        if not (where in edges and name in edges) and ids & other:
            problems.append(f"sequence_id: {next(iter(ids & other))} is in {name} and {where}")
    seen[where] = ids
print("\n".join(problems) or "ok")
sys.exit(1 if problems else 0)
