#!/usr/bin/env -S python3 -I
"""recipe/test <out>: exit 0 iff <out> holds a version of uniref50. From the shards' parquet footers and
three sampled row groups, in seconds: the shards are numbered without a gap, the schema is exactly
sequence_id and sequence (strings), every shard but the last is exactly shard_rows rows, the total is
exactly the release's count, and in the samples every sequence_id starts with UniRef50_ and every sequence
is uppercase letters only. One line per failure, naming the check and the first offending row."""
import re
import sys
import tomllib
from pathlib import Path

import pyarrow as pa
import pyarrow.parquet as pq

params = tomllib.loads((Path(__file__).parent / "params.toml").read_text())
PREFIX = "UniRef" + Path(__file__).resolve().parent.parent.name.removeprefix("uniref") + "_"
LETTERS = re.compile(r"[A-Z]+")

out, problems = Path(sys.argv[1]), []
files = sorted((out / "data").glob("*.parquet")) if (out / "data").is_dir() else []
if not files:
    problems.append("files: data/ holds no shards")
if [p.name for p in files] != [f"{i:05d}.parquet" for i in range(len(files))]:
    problems.append("files: data/'s shards are not 00000.parquet onward without a gap")

total, last, parsed = 0, 0, 0
for n, p in enumerate(files):
    try:
        pf = pq.ParquetFile(p)
    except Exception as e:
        problems.append(f"parses: {p.name} is not a parquet file: {e}")
        continue
    schema = pf.schema_arrow
    if schema.names != ["sequence_id", "sequence"] or any(schema.field(c).type != pa.string() for c in schema.names):
        problems.append(f"columns: {p.name} has {schema}, not exactly sequence_id and sequence as strings")
        continue
    parsed += 1
    shard_rows = pf.metadata.num_rows
    total += shard_rows
    last = shard_rows
    if n + 1 < len(files) and shard_rows != params["shard_rows"]:
        problems.append(f"rows: {p.name} holds {shard_rows}, not {params['shard_rows']}")

if parsed:
    if not 0 < last <= params["shard_rows"]:
        problems.append(f"rows: the last shard holds {last}, not at most {params['shard_rows']} and at least 1")
    if total != params["sequences"]:
        problems.append(f"rows: the shards hold {total} in all, not the release's {params['sequences']}")
    picks = sorted({0, len(files) // 2, len(files) - 1})
    sampled = 0
    for n in picks:
        p = files[n]
        try:
            pf = pq.ParquetFile(p)
        except Exception:
            continue
        groups = pf.metadata.num_row_groups
        g = 0 if n == 0 else groups - 1 if n == len(files) - 1 else groups // 2
        table = pf.read_row_group(g)
        ids, seqs = table.column("sequence_id").to_pylist(), table.column("sequence").to_pylist()
        sampled += len(ids)
        bad = next((s for s in ids if not s.startswith(PREFIX)), None)
        if bad is not None:
            problems.append(f"sequence_id: {p.name} row group {g} holds {bad!r}, not starting with {PREFIX}")
        bad = next((s for s in seqs if s is None or not LETTERS.fullmatch(s)), None)
        if bad is not None:
            problems.append(f"sequence: {p.name} row group {g} holds {bad!r}, not uppercase letters only")
    print(f"sampled: {len(picks)} row groups ({sampled} rows)")

print(f"data: {len(files)} shards, {total} rows")
print("\n".join(problems) or "ok")
sys.exit(1 if problems else 0)
