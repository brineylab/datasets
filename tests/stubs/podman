#!/usr/bin/env bash
# A stand-in for podman: appends its arguments to $TESTS_TMP/podman.args, then runs the command after
# the image here, so a fixture's recipe runs without one.
echo "$*" >> "$TESTS_TMP/podman.args"
[[ ${1:-} == run ]] && shift
while [[ $# -gt 0 ]]; do
  case $1 in
    -v|-w|-e) shift 2 ;;
    -*) shift ;;
    *) shift; break ;;  # the image
  esac
done
exec "$@"
